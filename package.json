{
  "name": "quran-web-static",
  "version": "1.0.0",
  "private": true,
  "browserslist": [
    "defaults",
    "not dead",
    "supports es6-module"
  ],
  "scripts": {
    "dev": "node scripts/copy-globals-for-async.js && npx next dev -H 0.0.0.0",
    "build": "node scripts/copy-globals-for-async.js && node scripts/generate-image-sitemap.js && next build",
    "build:analyze": "node scripts/copy-globals-for-async.js && node -e \"process.env.ANALYZE='true'; require('child_process').spawnSync('npx', ['next', 'build'], {stdio:'inherit', shell:true})\"",
    "start": "next start",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "generate-image-sitemap": "node scripts/generate-image-sitemap.js",
    "lint": "npx next lint",
    "optimize:svgs": "npx svgo public --recursive --multipass"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@types/node": "^20.11.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "fontkit": "^2.0.4",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "hls.js": "^1.6.15",
    "next": "^14.2.0",
    "pako": "^2.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
